# Copiez ce fichier en .env puis remplacez les valeurs. Ne publiez jamais .env.
# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=COLLEZ_VOTRE_CLE_ICI
GEMINI_MODEL=gemini-2.5-flash
BOT_NAME=SIPOKBOT

# Numéro du propriétaire (commandes !bot on/off), indicatif pays, chiffres seulement. Exemple fictif :
OWNER_NUMBER=22890000000

# Serveur sans écran : numéro du compte WhatsApp à lier (même format). Le bot affiche
# alors un code à 8 caractères au lieu d'un QR. Laissez vide pour utiliser le QR.
PAIRING_NUMBER=

# --- Réglages facultatifs ---
# MAX_REPLIES_PER_DAY=300      # plafond de réponses/jour (0 = illimité)
# MAX_MSG_PER_MINUTE=8         # par contact
# MAX_MESSAGE_AGE_S=120        # ignore les messages plus vieux (rattrapage après coupure)
# DISCONNECT_RESTART_MIN=10    # redémarre le processus si déconnecté plus longtemps
# GEMINI_THINKING_BUDGET=      # vide = 0 pour gemini-2.5-flash
